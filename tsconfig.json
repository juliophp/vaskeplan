{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": ["src", "shared", "server", "vite.config.js", "nitro.config.js"]
}
